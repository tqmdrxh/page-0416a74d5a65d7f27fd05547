1fr 1fr;gap:18px 32px}\n  .qa{background:var(--ink-soft);border-radius:22px;padding:24px 26px;box-shadow:0 14px 34px rgba(0,0,0,.45)}\n  .qa h3{margin:0 0 10px;font-size:1rem;line-height:1.4;font-weight:700;color:var(--paper)}\n  .qa h3::before{content:\"\";display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--neon);margin-right:10px;vertical-align:2px}\n  .qa p{margin:0;font-size:14px;color:#a9b1a8;line-height:1.7}\n\n  /* ============ 页脚 ============ */\n  footer{border-top:1px solid var(--line);padding:34px 0 46px;font-size:13px;color:#7d857d}\n  .foot-row{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;align-items:baseline}\n  .foot-row strong{color:var(--neon);letter-spacing:.28em;font-size:12px;text-transform:uppercase}\n  footer p{margin:14px 0 0;max-width:60em;line-height:1.7}\n\n  @media (max-width:900px){\n    .hero-grid{grid-template-columns:1fr;gap:30px}\n    .steps{grid-template-columns:1fr 1fr}\n    .clients{grid-template-columns:1fr 1fr}\n    .faq-grid{grid-template-columns:1fr}\n  }\n  @media (max-width:560px){\n    .steps{grid-template-columns:1fr}\n    .clients{grid-template-columns:1fr}\n    section{padding:46px 0}\n    .hero{padding:24px 0 40px}\n    .factlist li{grid-template-columns:76px 1fr}\n  }\n</style><header class=\"hero\">\n  <div class=\"wrap\">\n    <div class=\"hero-top\">\n      <div class=\"brandmark\">Wallless <span>／ 订阅说明</span></div>\n      <div class=\"issn\">方案 · 用量 · 设备 · 账务</div>\n    </div>\n\n    <div class=\"hero-grid\">\n      <div>\n        <p class=\"kicker\">选择之前，先看清单</p>\n        <h1>Wallless：把套餐写清楚，<em>再让你决定</em></h1>\n        <p class=\"lede\">三档方案，差别只在三件事：每月流量、同时在线设备数、线路与支持等级。下面的表格把它们排在同一行，方便逐格对照。</p>\n\n        <ul class=\"anchors\">\n          <li><a href=\"#plans\">套餐对比</a></li>\n          <li><a href=\"#howto\">使用流程</a></li>\n          <li><a href=\"#clients\">客户端</a></li>\n          <li><a href=\"#faq\">常见问题</a></li>\n        </ul>\n\n        <blockquote class=\"hero-quote\">\n          不写形容词，只写数字。流量、设备数、价格，都可以核对；其余描述以实际页面为准。\n          Wallless 编辑说明\n        </blockquote>\n      </div>\n\n      <aside class=\"factbox\">\n        <h2>一页速览</h2>\n        <ul class=\"factlist\">\n          <li><span class=\"k\">方案数量</span><span class=\"v\">3 档：基础版、旗舰版、团队版</span></li>\n          <li><span class=\"k\">起价</span><span class=\"v\">¥15／月</span></li>\n          <li><span class=\"k\">流量区间</span><span class=\"v\">100GB 至 1000GB ／月</span></li>\n          <li><span class=\"k\">设备数</span><span class=\"v\">3 台、5 台、20 台</span></li>\n          <li><span class=\"k\">计费方式</span><span class=\"v\">月付，或按年付</span></li>\n          <li><span class=\"k\">适合谁</span><span class=\"v\">个人用户、重度使用者、小团队</span></li>\n        </ul>\n        <p class=\"factnote\">价格与权益为本页所列内容，实际订阅前请以订阅页展示的最终信息为准。本站不提供支付与下载托管。</p>\n      </aside>\n    </div>\n  </div>\n</header>\n\n<main>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>三档套餐，横向对照</h2>\n        <p>同一行比较同一项指标。加粗数字是可以直接核对的，其余文字是说明。</p>\n      </div>\n\n      <div class=\"table-scroll\">\n        <table>\n          Wallless 订阅方案对比（币种：人民币）\n          <thead>\n            <tr>\n              <th>对比项</th>\n              <th>\n                <span class=\"plan-name\">基础版</span>\n                <span class=\"plan-price\">¥15／月</span>\n                <span class=\"plan-annual\">按年付 ¥150／年</span>\n              </th>\n              <th>\n                <span class=\"flag\">推荐</span>\n                <span class=\"plan-name\">旗舰版</span>\n                <span class=\"plan-price\">¥35／月</span>\n                <span class=\"plan-annual\">按年付 ¥350／年</span>\n              </th>\n              <th>\n                <span class=\"plan-name\">团队版</span>\n                <span class=\"plan-price\">¥85／月</span>\n                <span class=\"plan-annual\">按年付 ¥850／年</span>\n              </th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>每月流量</th>\n              <td>100GB</td>\n              <td>300GB</td>\n              <td>1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td>5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>线路说明</th>\n              <td>普通线路节点池</td>\n              <td>全节点流媒体解锁，IPLC 专线游戏加速优化</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>流媒体</th>\n              <td>解锁基础流媒体</td>\n              <td>全节点原生流媒体解锁</td>\n              <td>随 VIP 节点一并提供</td>\n            </tr>\n            <tr>\n              <th>附加能力</th>\n              <td class=\"td-note\">按标准方案使用</td>\n              <td class=\"td-note\">按标准方案使用</td>\n              <td>支持企业定制路由</td>\n            </tr>\n            <tr>\n              <th>支持方式</th>\n              <td class=\"td-note\">标准工单</td>\n              <td>7×24 优先工单支持</td>\n              <td>专属客户经理服务</td>\n            </tr>\n            <tr>\n              <th>月付价格</th>\n              <td>¥15</td>\n              <td>¥35</td>\n              <td>¥85</td>\n            </tr>\n            <tr>\n              <th>年付价格</th>\n              <td>¥150／年</td>\n              <td>¥350／年</td>\n              <td>¥850／年</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      <p class=\"table-foot\">按年付相当于十个月的价格，具体结算金额与可用支付方式以订阅页为准。年付是否支持中途变更方案，请在下单前确认。</p>\n    </div>\n  </section>\n\n  <section id=\"howto\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>从下单到日常使用，四步</h2>\n        <p>顺序固定，不必跳步。每一步都可以停下来核对。</p>\n      </div>\n\n      <ol class=\"steps\">\n        <li>\n          <h3>先量用量</h3>\n          <p>回看上一个月的实际流量与设备数。流量常年低于 100GB、设备不超过 3 台，从基础版起步即可。</p>\n        </li>\n        <li>\n          <h3>再对人数</h3>\n          <p>把手机、平板、电脑都算进设备数。多人共用时，同时在线台数才是约束条件，而不是账号数量。</p>\n        </li>\n        <li>\n          <h3>确定计费周期</h3>\n          <p>月付灵活，年付单价更低。若用量还在变化，先用月付跑满一个周期，再决定是否转年付。</p>\n        </li>\n        <li>\n          <h3>接入并观察</h3>\n          <p>在客户端完成配置后，留意实际速率与连接稳定性。若长期贴近流量上限，再考虑升一档。</p>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>客户端</h2>\n        <p>本页不提供安装包。下载渠道与账号信息请以你订阅时获得的方式为准。</p>\n      </div>\n\n      <div class=\"clients\">\n        <article class=\"client\">\n          <span class=\"meta\">桌面端</span>\n          <h3>Windows 与 macOS</h3>\n          <p>在电脑上长期使用的场景，适合配合固定设备数量的方案。安装后按账号提供的配置信息完成接入，具体步骤以客户端内提示为准。</p>\n          <a href=\"#\">查看说明 →</a>\n        </article>\n        <article class=\"client\">\n          <span class=\"meta\">移动端</span>\n          <h3>iOS 与 Android</h3>\n          <p>外出时的主要入口。手机通常占用一个设备名额，若同时携带平板，请把两台都计入同时在线数量。</p>\n          <a href=\"#\">查看说明 →</a>\n        </article>\n        <article class=\"client\">\n          <span class=\"meta\">路由与团队</span>\n          <h3>多设备与团队接入</h3>\n          <p>当接入点超过 5 个，团队版更合适：20 台设备上限，并支持企业定制路由。具体配置需求请与客户经理沟通。</p>\n          <a href=\"#\">查看说明 →</a>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>常见问题</h2>\n        <p>问题按出现频率排列，答案尽量短，能核对的都给出数字。</p>\n      </div>\n\n      <div class=\"faq-grid\">\n        <article class=\"qa\">\n          <h3>年付和月付差在哪？</h3>\n          <p>只差结算周期与总额。基础版 ¥150／年、旗舰版 ¥350／年、团队版 ¥850／年，均相当于十个月的月付价格。功能与流量不因计费周期改变。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>同时在线设备是怎么算的？</h3>\n          <p>按同一时刻在线的设备台数计。基础版 3 台、旗舰版 5 台、团队版 20 台。换设备不等于加名额，下线一台即可让另一台接入。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>流量每月什么时候重置？</h3>\n          <p>按你的计费周期滚动计算，而不是自然月。具体重置日以订阅页显示的周期起始日为准，建议下单后核对一次。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>用超了会怎样？</h3>\n          <p>不宜自行假设处理方式。若某月接近上限，最稳妥的做法是在周期内升级到更高一档，或在下个周期调整方案。细则请以订阅页条款为准。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>可以中途换方案吗？</h3>\n          <p>升级与降级的规则由订阅条款约定，本页不代为承诺。年付用户尤其需要在续费前确认，避免结算周期内出现差额争议。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>团队版适合多大的团队？</h3>\n          <p>大致对应同时在线 6 至 20 台设备的规模，并需要企业定制路由时。若只是两三个人共用，旗舰版的 5 台通常已经够用。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>页面上的价格是最终价吗？</h3>\n          <p>本页列出的是方案标价，用于对比。实际应付金额、可用支付方式及是否有其他费用，以你下单时看到的结算信息为准。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>在哪里下载客户端？</h3>\n          <p>本页不托管安装包，也不提供下载地址。请通过你订阅时获得的官方渠道获取客户端，并核对来源后再安装。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-row\">\n      <strong>Wallless</strong>\n      <span>方案对比 · 使用说明 · 常见问题</span>\n    </div>\n    <p>本页为方案说明性质的内容，价格与权益取自套餐列表，用于横向比较；具体订阅、结算与支持范围以订阅页条款为准。页面不提供支付入口，也不托管任何安装文件。</p>\n  </div>\n</footer>",
